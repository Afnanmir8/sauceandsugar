# Local Vite only. Leave this UNSET on Render so the live site talks to the same server.
VITE_ORDER_ENDPOINT=http://localhost:8787/api/orders

# Strong private password for http://your-site/?admin=1
ADMIN_TOKEN=change-me-to-a-long-secret

# Persistent data folder on the host. Locally you can omit this.
# DATA_DIR=/var/data

# Locality delivery fees in rupees. Allowed values: 40, 50, 80.
DELIVERY_FEES_BY_AREA={"Lalpur":40,"Harmu":40,"Kanke Road":40,"Bariatu":40,"Argora":40,"Hinoo":40,"Doranda":40,"Ratu Road":40,"Kokar":50,"Morabadi":40,"Main Road":40,"Dhurwa":80,"Birsa Chowk":50,"Other":80}
